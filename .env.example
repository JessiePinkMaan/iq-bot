# ============================================================
#  NOEMA · IQ TEST BOT - пример конфигурации
#  Скопируй в .env и заполни значения
# ============================================================

# 1. Создай бота у @BotFather (/newbot) и вставь токен.
#    Формат: 123456789:AAH...
BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Узнай свой Telegram ID у @userinfobot и вставь сюда.
#    Несколько администраторов: 111111111,222222222
ADMIN_IDS=111111111

# 3. Цена полного отчёта в Telegram Stars (XTR).
PRICE_STARS=50

# 4. Постоянный секрет для HMAC-подписи платёжных payload.
#    Сгенерируй случайную строку, например: openssl rand -hex 32
#    Если оставить пустым - секрет будет выведен из BOT_TOKEN.
PAYMENT_SECRET=replace-me-with-a-long-random-string

# 5. База данных SQLite.
DB_PATH=data/noema.sqlite3

# 6. Часовой пояс для отображения дат.
TIMEZONE=Europe/Moscow

# 7. Уровень логирования.
LOG_LEVEL=INFO

# 8. Бренд в интерфейсе и счетах.
BRAND=NOEMA

# 9. Контакт поддержки (необязательно): @username или https://t.me/...
SUPPORT_CONTACT=@your_support
